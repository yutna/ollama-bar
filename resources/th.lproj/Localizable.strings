/* Alert body when the server cannot be stopped */
"alert.stopFailed.body" = "ยังมี process ของ ollama ทำงานอยู่ ลองอีกครั้ง หรือตรวจสอบด้วย `pgrep -fl ollama`";

/* Alert title when warm-up is requested but no model is installed */
"alert.noModels.title" = "ยังไม่มีโมเดลติดตั้งอยู่";

/* Alert body when warm-up is requested but no model is installed */
"alert.noModels.body" = "รัน `ollama pull <model>` ก่อน";

/* Alert title when warm-up is requested but the server does not answer */
"alert.unreachable.title" = "Ollama ไม่ตอบสนอง";

/* Alert body when warm-up is requested but the server does not answer */
"alert.unreachable.body" = "เซิร์ฟเวอร์ไม่ตอบสนองต่อคำขอ เริ่มเซิร์ฟเวอร์แล้วลองอีกครั้ง";

