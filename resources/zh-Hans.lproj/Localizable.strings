/* Menu header when the server is stopped */
"menu.status.stopped" = "○ Ollama 已停止";

/* Menu header when the server is running without a loaded model */
"menu.status.running" = "● Ollama 正在运行 — 未加载模型";

/* Menu header when the server is running with one or more loaded models. %@ is the model list */
"menu.status.runningModels" = "● Ollama 正在运行 — %@";

/* Menu item that starts the server */
"menu.start" = "▶︎ 启动 Ollama（优化默认值）";

/* Menu item that stops the server and frees RAM */
"menu.stop" = "■ 停止 Ollama（立即释放内存）";

/* Menu item that preloads the first installed model */
"menu.warm" = "🔥 预热模型（预加载）";

/* Menu item that toggles the login item */
"menu.login" = "登录时显示图标";

/* Menu item shown while the login item awaits approval in System Settings */
"menu.login.pending" = "登录项需要批准 — 打开系统设置";

/* Accessibility label of the menu bar icon */
"accessibility.icon" = "OllamaBar";

/* Menu item that quits the app */
"menu.quit" = "退出（同时停止 Ollama）";

/* Tooltip when the server is stopped */
"tooltip.stopped" = "Ollama 已停止 — 点击启动";

/* Tooltip when the server is running without a loaded model */
"tooltip.running" = "Ollama 正在运行 — 未加载模型";

/* Tooltip when the server is running with a loaded model */
"tooltip.runningLoaded" = "Ollama 正在运行 — 已加载模型";

/* Alert title when the login item cannot be changed */
"alert.login.title" = "无法更改登录项";

/* Alert body when the login item cannot be changed. %@ is the error detail */
"alert.login.body" = "请在「系统设置 → 通用 → 登录项」中手动添加。\n\n%@";

/* Alert title when the ollama binary cannot be found */
"alert.notFound.title" = "未找到 Ollama";

/* Alert body when the ollama binary cannot be found */
"alert.notFound.body" = "请从 https://ollama.com 安装 Ollama，或运行：brew install ollama";

/* Alert title when the server fails to start */
"alert.startFailed.title" = "无法启动 Ollama";

/* Alert title when warm-up is requested but no model is installed */
"alert.noModels.title" = "未安装任何模型";

/* Alert body when warm-up is requested but no model is installed */
"alert.noModels.body" = "请先运行 `ollama pull <model>`。";

/* Alert title when warm-up fails */
"alert.warmFailed.title" = "无法预热模型";

/* Alert body when warm-up fails. %@ is the model name */
"alert.warmFailed.body" = "预热 %@ 失败。详情请查看 ~/.ollama/logs/server.log。";

/* Error: the ollama executable is missing */
"error.binaryNotFound" = "找不到 `ollama` 可执行文件。";

/* Error: the server did not become ready in time. %d is a number of seconds */
"error.launchTimeout" = "服务器未能在 %d 秒内就绪。";

/* Error: readiness timeout with the tail of server.log. %d seconds, %@ log */
"error.launchTimeoutWithLog" = "服务器未能在 %d 秒内就绪。\n\n%@";
