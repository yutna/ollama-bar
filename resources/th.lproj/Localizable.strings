/* Alert title when the ollama binary cannot be found */
"alert.notFound.title" = "ไม่พบ Ollama";

/* Alert body when the ollama binary cannot be found */
"alert.notFound.body" = "ติดตั้ง Ollama จาก https://ollama.com หรือรัน: brew install ollama";

/* Alert title when the server fails to start */
"alert.startFailed.title" = "เริ่ม Ollama ไม่สำเร็จ";

